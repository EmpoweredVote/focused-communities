# Covers bare `.env` plus every variant, including suffixed ones
# like .env.bak and .env.save that exact-match rules miss.
.env
.env.*
!.env.example
!.env.*.example
supabase/.temp/

# Editor/tooling backups. A `.env.bak` holding live credentials sat
# untracked in ev-accounts on 2026-07-26 and a single `git add -A`
# would have published it.
*.bak
*.backup
*.orig
*~

# Playwright MCP page captures. 556 of these were committed to
# ev-accounts and held live credentials.
.playwright-mcp/

# Throwaway brainstorm mockups from the superpowers visual companion.
.superpowers/

# Two documents that are authoritative somewhere other than this repo, kept
# out so a local copy cannot drift from the real one and be read as current.
#
# empowered-vote-primer.md is org-wide — it opens "read this document fully
# before writing any code", which is a claim no single repo should be making
# a private copy of. It belongs somewhere one edit reaches every repo; until
# it has that home, this ignore is the placeholder, not the decision.
#
# 10_Connect_Issues-in-Focus-detailed.md is numbered as part of a series
# maintained elsewhere, so the same reasoning applies.
empowered-vote-primer.md
10_Connect_Issues-in-Focus-detailed.md
